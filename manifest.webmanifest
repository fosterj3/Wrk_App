{
  "name": "Cadence — Workout Log",
  "short_name": "Cadence",
  "description": "A local-first workout log. Paste in the routine you already keep, log the work, see the pattern.",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1A0A1B",
  "theme_color": "#1A0A1B",
  "_comment_links": "A tapped link opens the browser by default, even when the app is installed. These ask the installed app to take its own links instead, and to reuse the window it already has rather than opening a second one. Chrome and Edge honour both; iOS ignores them entirely, which is why the share sheet also offers plain text.",
  "handle_links": "preferred",
  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://fosterj3.github.io/Wrk_App/manifest.webmanifest"
    }
  ],
  "icons": [
    { "src": "icons/icon-192-v2.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512-v2.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
